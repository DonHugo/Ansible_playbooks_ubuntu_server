# ============================================================
# Frigate environment variables
# Copy to /home/hugo/frigate/.env and fill in real values
# ============================================================

# Non-secret network values (required)
FRIGATE_BIND_ADDRESS=YOUR_UBUNTU_1_LAN_IP
FRIGATE_MQTT_HOST=YOUR_HOME_ASSISTANT_MQTT_IP
FRIGATE_USB_CAMERA_RTSP_URL=rtsp://YOUR_UBUNTU_2_LAN_IP:8554/usb_camera

# MQTT credentials (required; placeholders only)
FRIGATE_MQTT_USER=CHANGEME
FRIGATE_MQTT_PASSWORD=CHANGEME
